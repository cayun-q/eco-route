# Postgres — docker compose uses these defaults
DATABASE_URL=postgres://carbonroute:carbonroute@127.0.0.1:5432/carbonroute

# Express
PORT=43124

# Car roads: public OSRM (no API key). Plane uses airport-aware curved corridor.
OSRM_BASE_URL=https://router.project-osrm.org
# Set to 1 only if you want a labeled non-road fallback when OSRM is down.
OSRM_LABELED_FALLBACK=

# Optional alternate road providers (unused when OSRM succeeds for car).
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
ORS_API_KEY=

# Expo app (apps/mobile)
EXPO_PUBLIC_API_URL=http://127.0.0.1:43124
