# Postgres — docker compose uses these defaults
DATABASE_URL=postgres://carbonroute:carbonroute@127.0.0.1:5432/carbonroute

# Express
PORT=43124

# Optional routing providers. Without any key, POST /api/routes/estimate
# geocodes via gazetteer + Nominatim and builds a haversine / great-circle polyline.
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
ORS_API_KEY=

# Expo app (apps/mobile)
EXPO_PUBLIC_API_URL=http://127.0.0.1:43124
