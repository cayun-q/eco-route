# Copy to .env at the repo root if you prefer a single file,
# or use apps/api/.env and apps/mobile/.env (see those .env.example files).

# --- API (apps/api) ---
DATABASE_URL=postgres://carbonroute:carbonroute@localhost:5432/carbonroute
PORT=43124
# mock | mapbox | google
ROUTING_PROVIDER=mock
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# --- Mobile (apps/mobile) ---
# Use your machine LAN IP (not localhost) when testing on a physical device.
EXPO_PUBLIC_API_URL=http://127.0.0.1:43124
