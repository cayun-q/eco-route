# Postgres — docker compose uses these defaults
DATABASE_URL=postgres://carbonroute:carbonroute@127.0.0.1:5432/carbonroute

# Express
PORT=43124

# Optional road-routing providers. Car / EV / bus fall back through the configured
# providers and finally public OSRM. Bicycle and walking use OpenRouteService,
# so ORS_API_KEY is required for those two modes.
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
ORS_API_KEY=

# Expo app (apps/mobile)
EXPO_PUBLIC_API_URL=http://127.0.0.1:43124
