DATABASE_URL=postgres://carbonroute:carbonroute@localhost:5432/carbonroute
PORT=43124

# Routing: mock uses city lookup + haversine (no key needed).
# Set ROUTING_PROVIDER=mapbox, google, or ors and drop a key below to switch.
ROUTING_PROVIDER=mock
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
# OpenRouteService — used when ROUTING_PROVIDER=ors (car directions).
# Get a key at https://openrouteservice.org/ — never commit it.
ORS_API_KEY=
