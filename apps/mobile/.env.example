# API used by Expo (web, simulator, or device).
# On a physical phone, replace 127.0.0.1 with your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://127.0.0.1:43124

# Optional. Native Android / Google Maps tiles for react-native-maps.
# iOS uses Apple Maps without a key. Expo web uses Leaflet + OSM (no key).
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
