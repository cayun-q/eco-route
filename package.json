{
  "name": "carbonroute",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "api": "npm run dev --workspace=@carbonroute/api",
    "api:start": "npm run start --workspace=@carbonroute/api",
    "seed": "npm run seed --workspace=@carbonroute/api",
    "mobile": "npm run start --workspace=@carbonroute/mobile",
    "web": "npm run web --workspace=@carbonroute/mobile",
    "test": "npm run test --workspace=@carbonroute/shared && npm run test --workspace=@carbonroute/api"
  },
  "engines": {
    "node": ">=20"
  }
}
